  "official": true,
  "type": "domain_module",
  "versions": [
    {
      "tag": "1.0",
      "target_api": "Namecheap API",
      "digest": "",
      "config_schema": [
        {
          "order": 1,
          "type": "string",
          "label": "API User",
          "description": "Your Namecheap API username",
          "regex": "",
          "required": true,
          "key": "api_user"
        },
        {
          "order": 2,
          "type": "secret",
          "label": "API Key",
          "description": "Your Namecheap API key",
          "regex": "",
          "required": true,
          "key": "api_key"
        },
        {
          "order": 3,
          "type": "string",
          "label": "Username",
          "description": "Your Namecheap account username (usually the same as the API user)",
          "regex": "",
          "required": true,
          "key": "username"
        },
        {
          "order": 4,
          "type": "string",
          "label": "Client IP",
