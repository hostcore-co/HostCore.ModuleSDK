          "required": true,
          "key": "client_ip"
        },
        {
          "order": 5,
          "type": "bool",
          "label": "Sandbox",
          "description": "Use the Namecheap sandbox API (api.sandbox.namecheap.com)",
          "regex": "",
          "required": false,
          "key": "sandbox"
        }
      ],
