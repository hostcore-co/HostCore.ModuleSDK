{
  "name": "cPanel & WHM",
  "author": "HostCore",
  "description": "Official module for cPanel/WHM web hosting",
  "documentation_url": "https://docs.hostcore.co/modules/cpanel",
  "official": true,
  "type": "service_module",
  "versions": [
    {
      "tag": "1.0",
      "target_api": "WHM API 1",
      "digest": "",
      "config_schema": [
        {
          "order": 1,
          "type": "string",
          "label": "WHM Hostname",
          "description": "Your WHM server's hostname (eg. whm.domain.com)",
          "regex": "^(?!https?://)[a-z0-9]+(?:\\.[a-z0-9-]+)*\\.[a-z]{2,}$",
          "required": true,
          "key": "domain"
        },
        {
          "order": 2,
          "type": "secret",
          "label": "API Token",
          "description": "A WHM API token",
          "regex": "",
          "required": true,
          "key": "api_key"
        },
        {
          "order": 3,
          "type": "string",
          "label": "API User",
          "description": "The WHM user the token belongs to (default: root)",
          "regex": "^[a-z][a-z0-9]*$",
          "required": false,
          "key": "username"
        }
      ],
      "created_at": {
        "$date": "2026-07-19T00:00:00.000Z"
      },
      "actions": [
        {
          "order": 1,
          "value": "sso",
          "label": "Open cPanel",
          "description": "Signs in to cPanel without needing the account password.",
          "confirm": "",
          "effect": "redirect",
          "style": "primary",
          "statuses": [
            "active"
          ]
        }
      ]
    }
  ],
  "created_at": {
    "$date": "2026-07-19T00:00:00.000Z"
  },
  "updated_at": {
    "$date": "2026-07-19T00:00:00.000Z"
  }
}
