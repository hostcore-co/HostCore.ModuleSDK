{
  "name": "Pterodactyl",
  "author": "HostCore",
  "description": "Official module for the Pterodactyl game panel",
  "documentation_url": "https://docs.hostcore.co/modules/pterodactyl",
  "official": true,
  "type": "service_module",
  "versions": [
    {
      "tag": "1.0",
      "target_api": "Pterodactyl v1 API",
      "digest": "",
      "config_schema": [
        {
          "order": 1,
          "type": "string",
          "label": "Panel Domain",
          "description": "Your Pterodactyl panel's domain (eg. panel.domain.com)",
          "regex": "^(?!https?://)[a-z0-9]+(?:\\.[a-z0-9-]+)*\\.[a-z]{2,}$",
          "required": true,
          "key": "domain"
        },
        {
          "order": 2,
          "type": "secret",
          "label": "API Key",
          "description": "Your Pterodactyl application API key",
          "regex": "",
          "required": true,
          "key": "api_key"
        }
      ],
      "created_at": {
        "$date": "2026-07-19T00:00:00.000Z"
      },
      "actions": [
        {
          "order": 1,
          "value": "reinstall",
          "label": "Reinstall server",
          "description": "Rebuilds the server from its egg. Files are wiped.",
          "confirm": "Reinstall the server? Every file on it is deleted and the server is rebuilt from scratch.",
          "effect": "refresh",
          "style": "danger",
          "statuses": [
            "active"
          ]
        }
      ]
    }
  ],
  "created_at": {
    "$date": "2026-07-19T00:00:00.000Z"
  },
  "updated_at": {
    "$date": "2026-07-19T00:00:00.000Z"
  }
}
