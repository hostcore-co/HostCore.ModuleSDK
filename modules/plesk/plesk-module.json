{
  "name": "Plesk",
  "author": "HostCore",
  "description": "Official module for Plesk web hosting",
  "documentation_url": "https://docs.hostcore.co/modules/plesk",
  "official": true,
  "type": "service_module",
  "versions": [
    {
      "tag": "1.0",
      "target_api": "Plesk REST API v2",
      "digest": "",
      "config_schema": [
        {
          "order": 1,
          "type": "string",
          "label": "Plesk Hostname",
          "description": "Your Plesk server's hostname (eg. plesk.domain.com)",
          "regex": "^(?!https?://)[a-z0-9]+(?:\\.[a-z0-9-]+)*\\.[a-z]{2,}$",
          "required": true,
          "key": "domain"
        },
        {
          "order": 2,
          "type": "secret",
          "label": "API Key",
          "description": "A Plesk REST API key",
          "regex": "",
          "required": true,
          "key": "api_key"
        }
      ],
      "created_at": {
        "$date": "2026-07-19T00:00:00.000Z"
      },
      "actions": [
        {
          "order": 1,
          "value": "sso",
          "label": "Open Plesk",
          "description": "Signs in to Plesk without needing the account password.",
          "confirm": "",
          "effect": "redirect",
          "style": "primary",
          "statuses": [
            "active"
          ]
        }
      ]
    }
  ],
  "created_at": {
    "$date": "2026-07-19T00:00:00.000Z"
  },
  "updated_at": {
    "$date": "2026-07-19T00:00:00.000Z"
  }
}
