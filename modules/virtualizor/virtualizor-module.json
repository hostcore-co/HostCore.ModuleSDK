{
  "name": "Virtualizor",
  "author": "HostCore",
  "description": "Official module for the Virtualizor VPS panel",
  "documentation_url": "https://docs.hostcore.co/modules/virtualizor",
  "official": true,
  "type": "service_module",
  "versions": [
    {
      "tag": "1.0",
      "target_api": "Virtualizor Admin API",
      "digest": "",
      "config_schema": [
        {
          "order": 1,
          "type": "string",
          "label": "Panel Hostname",
          "description": "Your Virtualizor server's hostname (eg. vz.domain.com)",
          "regex": "^(?!https?://)[a-z0-9]+(?:\\.[a-z0-9-]+)*\\.[a-z]{2,}$",
          "required": true,
          "key": "domain"
        },
        {
          "order": 2,
          "type": "secret",
          "label": "API Key",
          "description": "Your Virtualizor Admin API key",
          "regex": "",
          "required": true,
          "key": "api_key"
        },
        {
          "order": 3,
          "type": "secret",
          "label": "API Password",
          "description": "Your Virtualizor Admin API password",
          "regex": "",
          "required": true,
          "key": "api_pass"
        }
      ],
      "created_at": {
        "$date": "2026-07-19T00:00:00.000Z"
      },
      "actions": [
        {
          "order": 1,
          "value": "start",
          "label": "Start",
          "description": "Powers the VPS on.",
          "confirm": "",
          "effect": "refresh",
          "style": "primary",
          "statuses": [
            "active"
          ]
        },
        {
          "order": 2,
          "value": "restart",
          "label": "Restart",
          "description": "Reboots the VPS.",
          "confirm": "Restart the VPS? It will be unavailable while it reboots.",
          "effect": "refresh",
          "style": "default",
          "statuses": [
            "active"
          ]
        },
        {
          "order": 3,
          "value": "stop",
          "label": "Stop",
          "description": "Shuts the VPS down.",
          "confirm": "Stop the VPS? Anything running on it will stop.",
          "effect": "refresh",
          "style": "danger",
          "statuses": [
            "active"
          ]
        }
      ]
    }
  ],
  "created_at": {
    "$date": "2026-07-19T00:00:00.000Z"
  },
  "updated_at": {
    "$date": "2026-07-19T00:00:00.000Z"
  }
}
