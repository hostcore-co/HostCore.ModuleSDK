{
  "name": "VirtFusion",
  "author": "HostCore",
  "description": "Official module for the VirtFusion VPS panel",
  "documentation_url": "https://docs.hostcore.co/modules/virtfusion",
  "official": true,
  "type": "service_module",
  "versions": [
    {
      "tag": "1.0",
      "target_api": "VirtFusion API v1",
      "digest": "",
      "config_schema": [
        {
          "order": 1,
          "type": "string",
          "label": "Panel Hostname",
          "description": "Your VirtFusion panel's hostname (eg. vf.domain.com)",
          "regex": "^(?!https?://)[a-z0-9]+(?:\\.[a-z0-9-]+)*\\.[a-z]{2,}$",
          "required": true,
          "key": "domain"
        },
        {
          "order": 2,
          "type": "secret",
          "label": "API Token",
          "description": "A VirtFusion API token",
          "regex": "",
          "required": true,
          "key": "api_key"
        }
      ],
      "created_at": {
        "$date": "2026-07-19T00:00:00.000Z"
      },
      "actions": [
        {
          "order": 1,
          "value": "sso",
          "label": "Open VirtFusion panel",
          "description": "Signs in to VirtFusion, where the console, backups and reinstall live.",
          "confirm": "",
          "effect": "redirect",
          "style": "primary",
          "statuses": [
            "active",
            "suspended"
          ]
        },
        {
          "order": 2,
          "value": "boot",
          "label": "Start",
          "description": "Powers the server on.",
          "confirm": "",
          "effect": "refresh",
          "style": "default",
          "statuses": [
            "active"
          ]
        },
        {
          "order": 3,
          "value": "shutdown",
          "label": "Shut down",
          "description": "Asks the server to shut down. It may decline.",
          "confirm": "Shut down the server? Anything running on it will stop.",
          "effect": "refresh",
          "style": "default",
          "statuses": [
            "active"
          ]
        },
        {
          "order": 4,
          "value": "restart",
          "label": "Restart",
          "description": "Reboots the server.",
          "confirm": "Restart the server? It will be unavailable while it reboots.",
          "effect": "refresh",
          "style": "default",
          "statuses": [
            "active"
          ]
        },
        {
          "order": 5,
          "value": "poweroff",
          "label": "Force stop",
          "description": "Cuts power without asking the server to shut down.",
          "confirm": "Force stop the server? This cuts power immediately and can lose unsaved data.",
          "effect": "refresh",
          "style": "danger",
          "statuses": [
            "active"
          ]
        }
      ]
    }
  ],
  "created_at": {
    "$date": "2026-07-19T00:00:00.000Z"
  },
  "updated_at": {
    "$date": "2026-07-19T00:00:00.000Z"
  }
}
